@@ -16,3 +16,11 @@ def apply_coupon(total: float, percent: float) -> float:
     """Take ``percent`` % off ``total``; ``percent`` is clamped to 0..100."""
     percent = max(0.0, min(100.0, percent))
     return round(total - total * percent / 100, 2)
