@@ -7,7 +7,7 @@ BULK_DISCOUNT_PCT = 10
 def bulk_price(qty: int, unit_price: float) -> float:
     """Total for ``qty`` units; orders of ``BULK_THRESHOLD`` or more get ``BULK_DISCOUNT_PCT`` % off."""
     total = qty * unit_price
