+import pytest
+from tiny.pricing import apply_coupon
+
+
+@pytest.mark.parametrize('pct,expected', [(0, 100.0), (50, 50.0), (100, 0.0)])
+def test_coupon(pct, expected):
+    assert apply_coupon(100.0, pct) == expected
+
+
+def test_bad_type():
+    with pytest.raises(TypeError):
+        apply_coupon('x', 10)
