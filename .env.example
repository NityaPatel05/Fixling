# Copy to .env and fill in. .env is gitignored and Claude Code is denied from reading it.
# Everything is optional for LOCAL runs (`fixling run --repo <path> --issue-file ...`); GitHub mode needs the token.

# Fine-grained PAT, scoped ONLY to your demo repos.
# Permissions: Contents RW, Pull requests RW, Issues RW, Metadata R.
GITHUB_TOKEN=

# Comma-separated repos the poller watches for the `fixling` label.
FIXLING_REPOS=your-user/minicart,your-user/textkit

# Only if LM Studio is NOT on this machine (default: http://localhost:1234/v1 from config/models.yaml).
# LMSTUDIO_BASE_URL=http://192.168.1.50:1234/v1

# Where run artifacts and the SQLite databases live (default: ./runs).
# FIXLING_RUNS_DIR=runs

# Dashboard link written into PR bodies (default: http://localhost:8000).
# FIXLING_DASHBOARD_URL=http://localhost:8000

# Directories the dashboard/API may copy for LOCAL runs (comma-separated). Empty = local runs via the API are off.
# FIXLING_LOCAL_ROOTS=C:/Users/you/Desktop/projects

# Red-team canary value used by tests/security (any random string). Anything that equals it is treated as a secret.
FIXLING_CANARY=FIXLING_CANARY_change_me
